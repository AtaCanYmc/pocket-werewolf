# Pocket Werewolf - Example Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Note: Credentials can also be configured dynamically at runtime inside the in-app Settings (⚙️) modal.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Admin Room Creation Password
# If left empty or unset, room creation is open to all visitors.
# If specified, hosts must provide this password to create a new room.
VITE_ADMIN_PASSWORD=
