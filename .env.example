# Pocket Werewolf - Example Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Note: Credentials can also be configured dynamically at runtime inside the in-app Settings (⚙️) modal.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=your-anon-public-key
